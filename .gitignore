__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.mypy_cache/
.pytest_cache/
config.yaml
pages/

# **A composition is a studio, and a studio is private** (Simon, 2026-10-21).
# Rig facts live in one on purpose — MIDI channels, drum maps, device names —
# because the package itself may never know about a particular studio.  So a
# composition belongs to the musician using Superconductor and is not something
# this repository distributes, its tests beside it included.  `examples/` holds
# the two neutral ones that document the API instead.
compositions/

# The stores an example writes beside itself when it is run from a checkout: what
# was made on the glass, and where each block sits.  A missing one is the ordinary
# case.
examples/*.json

# Code reviews stay private (Simon, 2026-10-21).
reviews/

# The agent brief. Kept out of the repository on purpose and held on backed-up
# storage instead, as the sequencer project does with its own.
CLAUDE.md

# The checkout's own Claude Code settings, which hold this project's agent
# credential for Subroutine (#3247).  The remote is public, and a personal
# ignore file on one machine does not reach git on another, so the rule is here.
.claude/settings.local.json
